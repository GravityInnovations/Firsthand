HOST=127.0.0.1
PORT=4100
CORS_ORIGINS=*
MAX_MEDIA_BYTES=52428800

# Local transcription stays inside the transcoder.
TRANSCRIPTION_PROVIDER=local
TRANSCRIPTION_LANGUAGE=en-US
TRANSCRIPTION_MODEL=onnx-community/whisper-base
TRANSCRIPTION_CACHE_DIR=.transformers-cache
TRANSCRIPTION_CHUNK_LENGTH_SECONDS=30

# The transformer receives text only: transcript, user description, and metadata.
TRANSFORMER_PROVIDER=openai
TRANSFORMER_API_KEY=
TRANSFORMER_MODEL=gpt-5.6-luna
TRANSFORMER_BASE_URL=https://api.openai.com/v1
TRANSFORMER_INSTRUCTIONS=

# Optional bearer token for callers of POST /v1/prepare.
API_AUTH_TOKEN=
